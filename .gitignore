# Ruby / Bundler
/.bundle

# Node.js
/node_modules
/app/assets/builds

# 環境変数
/.env
/.env.local
/.env.*.local

# シークレット・認証情報
/config/master.key
/config/*.key
/config/credentials/*.key

# macOS
.DS_Store

# データベース
/db/*.sqlite3
/storage/*.sqlite3
/storage/*.sqlite3-shm
/storage/*.sqlite3-wal

# ログ・一時ファイル
/log/
/tmp/*
!/tmp/pids/
!/tmp/pids/.keep

# ストレージ（開発環境のアップロードファイル・SQLite）
/storage/*
!/storage/.keep

# コンパイル済みアセット
/public/assets
