# Ruby / Bundler
/.bundle

# Node.js
/node_modules
/app/assets/builds

# 環境変数
/.env
/.env.local
/.env.*.local

# シークレット・認証情報
/config/master.key
/config/credentials/*.key

# ログ・一時ファイル
/log/*
!/log/.keep

/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
!/tmp/storage/
!/tmp/storage/.keep

# ストレージ（開発環境のアップロードファイル・SQLite）
/storage/*
!/storage/.keep

# コンパイル済みアセット
/public/assets
