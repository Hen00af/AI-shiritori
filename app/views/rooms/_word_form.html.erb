<%# app/views/rooms/_word_form.html.erb %>

<%= form_with model: Word.new, url: words_path, id: 'word_form', data: {
  shiritori_target: 'form',
  action: 'submit->shiritori#submitWord'
} do |f| %>
  <%= f.hidden_field :room_id, value: room.id %>
  <%= f.hidden_field :room_participant_id, value: current_participant&.id %>

  <div class="position-relative">
    <div class="d-flex gap-2 align-items-stretch">
      <%= f.text_field :body,
        class: 'form-control word-input flex-grow-1',
        placeholder: 'ひらがなで入力（ローマ字可）',
        autocomplete: 'off',
        autofocus: true,
        data: {
          shiritori_target: 'input',
          action: 'input->shiritori#previewScore'
        }
      %>
      <%= f.submit "SEND",
        class: 'game-btn',
        style: 'margin: 0; padding: 12px 20px; letter-spacing: 3px; font-size: 0.85rem;'
      %>
    </div>
    <div style="display: flex; justify-content: flex-end; margin-top: 4px; height: 16px;">
      <span data-shiritori-target="scorePreview" style="font-size: 0.72rem; color: rgba(0,255,180,0.5); font-family: 'Courier New', monospace; letter-spacing: 1px;"></span>
    </div>
  </div>
<% end %>
