<div class="container py-5 text-center" data-controller="waiting-room" data-waiting-room-room-id-value="<%= @room.id %>">

  <div style="max-width: 480px; margin: 0 auto;">
    <p class="game-label mb-2">WAITING ROOM</p>
    <h2 class="mb-1" style="letter-spacing: 4px;">ROOM #<%= @room.id %></h2>

    <div class="card mb-4 mt-4">
      <div class="card-body py-4">
        <p class="game-label mb-1">PLAYERS</p>
        <div style="font-size: 2rem; font-weight: 900; color: #00eaff; text-shadow: 0 0 12px #00eaff;">
          <span id="participant-count"><%= @room.room_participants.count %></span>
          <span style="color: rgba(0,234,255,0.4); font-size: 1.4rem;"> / <%= @room.max_players %></span>
        </div>

        <div class="mt-3" style="border-top: 1px solid rgba(0,234,255,0.1); padding-top: 16px;">
          <ul class="list-unstyled mb-0" id="participants-list">
            <%= render partial: 'rooms/participant', collection: @room.participants %>
          </ul>
        </div>

        <div class="mt-4" style="border-top: 1px solid rgba(0,234,255,0.1); padding-top: 16px;">
          <div style="display: flex; align-items: center; justify-content: center; gap: 8px; color: rgba(0,200,220,0.6); font-size: 0.8rem; letter-spacing: 2px;">
            <div class="spinner-border spinner-border-sm" role="status" style="width: 14px; height: 14px; border-color: rgba(0,234,255,0.4); border-right-color: transparent;"></div>
            対戦相手を待機中...
          </div>
        </div>
      </div>
    </div>

    <%= button_to "← ロビーへ戻る", leave_room_path(@room), method: :delete, class: "game-btn" %>
  </div>

</div>
