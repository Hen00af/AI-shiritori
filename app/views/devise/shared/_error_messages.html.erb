<% if resource.errors.any? %>
  <div class="alert alert-danger mb-3" style="font-size: 0.85rem; letter-spacing: 1px;">
    <div style="font-weight: bold; margin-bottom: 6px; color: #ffaaaa;">
      <%= resource.errors.count %>件のエラーがあります
    </div>
    <ul style="margin: 0; padding-left: 16px;">
      <% resource.errors.full_messages.each do |message| %>
        <li style="color: #ffcccc;"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
