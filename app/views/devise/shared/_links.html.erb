<div style="display: flex; flex-direction: column; gap: 6px; align-items: center; margin-top: 8px;">
  <%- if controller_name != 'sessions' %>
    <%= link_to "→ LOGIN", new_session_path(resource_name),
        style: "color: rgba(0,234,255,0.6); font-size: 0.8rem; letter-spacing: 2px; text-decoration: none; transition: color 0.2s;" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "→ CREATE ACCOUNT", new_registration_path(resource_name),
        style: "color: rgba(0,234,255,0.6); font-size: 0.8rem; letter-spacing: 2px; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "FORGOT PASSWORD?", new_password_path(resource_name),
        style: "color: rgba(0,200,220,0.4); font-size: 0.75rem; letter-spacing: 1px; text-decoration: none;" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false } %>
    <% end %>
  <% end %>
</div>
