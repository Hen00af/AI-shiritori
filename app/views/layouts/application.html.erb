<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WORD CHASER" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <div class="titlecontainer">
      <div class="titlemenubox">
        <% if controller_name == "rooms" %>
          <div class="header-menu-container"
               <% if action_name == "index" %>
                 data-controller="bgm"
                 data-bgm-files-value="<%= [asset_path('bgm1.mp3'), asset_path('bgm2.mp3'), asset_path('bgm3.mp3')].to_json %>"
               <% end %>>

            <div class="music-controls">
              <% if action_name == "index" %>
                <button class="music-btn" data-action="click->bgm#toggle" data-bgm-target="toggleButton" title="BGM ON/OFF"
                        style="font-size: 18px; padding: 6px 10px;">
                  🔊
                </button>
                <button data-action="click->bgm#next" class="music-btn" title="次の曲"
                        style="font-size: 18px; padding: 6px 10px;">
                  ⏭
                </button>
              <% end %>
            </div>

            <div class="user-panel">
              <% if current_user %>
                <span class="username neon-blue" style="font-size: 14px;">
                  👾 <%= current_user.username %>
                </span>
                <%= button_to destroy_user_session_path, method: :delete, class: "logout-btn" do %>
                  LOGOUT
                <% end %>
              <% else %>
                <span class="username guest">GUEST MODE</span>
                <%= link_to "LOGIN", new_user_session_path, style: "color: rgba(0,234,255,0.6); font-size: 12px; letter-spacing: 2px; text-decoration: none;" %>
              <% end %>
            </div>

            <% if action_name == "index" %>
              <audio data-bgm-target="player" preload="auto" style="display: none;"></audio>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="titletext">
      <h3 class="titletext_sub2">高速しりとりバトル</h3>
      <h1 class="titletext_sub">WORD CHASER</h1>
    </div>

    <% if flash[:notice] || flash[:alert] %>
      <div style="position: fixed; top: 74px; left: 50%; transform: translateX(-50%); z-index: 500; min-width: 300px; max-width: 90vw;">
        <% if flash[:notice] %>
          <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size: 0.85rem; letter-spacing: 1px; text-align: center;">
            <%= flash[:notice] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1); opacity: 0.6;"></button>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert" style="font-size: 0.85rem; letter-spacing: 1px; text-align: center;">
            <%= flash[:alert] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1); opacity: 0.6;"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
