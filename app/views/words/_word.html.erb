<% score_class = word.score >= 15 ? 'word-high-score' : word.score > 0 ? 'word-scored' : 'word-zero' %>
<div class="word-history-item <%= score_class %>">
  <span class="word-history-bullet">▸</span>
  <span class="word-history-body"><%= word.body %></span>
  <% if word.score > 0 %>
    <span class="word-history-score">+<%= word.score %></span>
  <% end %>
</div>
