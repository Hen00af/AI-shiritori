# ===== Rails =====
RAILS_ENV=development
RAILS_MASTER_KEY=your_master_key_here
APP_HOST=localhost
APP_PROTOCOL=http
SOLID_QUEUE_IN_PUMA=true
ACTIVE_STORAGE_SERVICE=local

# ===== データベース（SQLite on mounted volume） =====
# ECS/Fargate では /rails/storage を EFS にマウントして永続化する
DATABASE_URL=sqlite3:/rails/storage/production.sqlite3

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== 外部API =====
GEMINI_API_KEY=

# ===== AWS デプロイ =====
AWS_REGION=ap-northeast-1
ECS_CLUSTER=ai-shiritori
ECS_SERVICE=ai-shiritori-web
IMAGE_TAG=latest
